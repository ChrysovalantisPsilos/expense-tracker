# Supabase build-time config. NOT committed with real values — the host
# (Vercel) injects these per environment; for local dev, copy this file to
# .env.local (gitignored) and fill in the TEST project's values.
#
# The client reads the PROD names first, then falls back to the _DEV names, so
# ONE build works in both Vercel environments — set only the pair that matches:
#
#   Vercel PROD env (budgeer.com):     VITE_SUPABASE_URL,     VITE_SUPABASE_ANON_KEY
#   Vercel DEV  env (dev.budgeer.com): VITE_SUPABASE_URL_DEV, VITE_SUPABASE_ANON_KEY_DEV
#
# The anon/publishable key is safe in the browser bundle (protected by Row
# Level Security). NEVER put the sb_secret_ (service_role) key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

