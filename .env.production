# Production build-time config for Vite — points at the PROD Supabase project
# ("Budge PROD", tuxfpylowcxazinqtrzx). Local dev and previews use the TEST
# project via .env.development instead.
#
# These VITE_* values are inlined into the client bundle at `vite build` time.
# The anon/publishable key is SAFE to commit and expose: it is designed to be
# shipped to browsers, and access is enforced by Postgres Row Level Security,
# not by keeping this key secret. It is already present in the public JS bundle.
#
# NEVER put the `sb_secret_` (service_role) key here — that one bypasses RLS.

VITE_SUPABASE_URL=https://tuxfpylowcxazinqtrzx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_r3hr7yLWxhUxNL9RXkrjqA_rKJ3zHV5
