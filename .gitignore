node_modules
dist
dist-ssr
*.local

# Env — keys are injected by the host (Vercel) at build time, never committed.
# Only the .env.example template is tracked.
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Supabase
supabase/.branches
supabase/.temp

# Local git worktrees
.claude/worktrees/

# Status page Worker: local wrangler state and secrets (status/.dev.vars)
status/.dev.vars
status/.wrangler/

# Mobile core: the bundle is built (npm run core:build) by CI and by Xcode;
# the recorded vectors (npm run core:vectors) are committed.
ios/BudgeerCore/Sources/BudgeerCore/Resources/core.js
ios/BudgeerCore/.build/
ios/BudgeerCore/.swiftpm/

# iOS app: the project is generated (xcodegen, from ios/Budgeer/project.yml),
# the strings from src/locales (npm run ios:strings); Xcode's own state too.
ios/Budgeer/Budgeer.xcodeproj/
# A developer's own signing (DEVELOPMENT_TEAM): never committed.
ios/Budgeer/Config/Local.xcconfig
ios/Budgeer/Budgeer/Info.plist
ios/Budgeer/BudgeerWidgets/Info.plist
ios/Budgeer/Budgeer/Resources/Generated/
ios/Budgeer/DerivedData/
ios/Budgeer/.swiftpm/
xcuserdata/
