<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PENDING THE APPLE TEAM ID (docs/IOS.md, "Universal links").
	     Once TEAM_ID is replaced in public/.well-known/apple-app-site-association
	     and that file is live on both sites, move this key out of the comment
	     so links to /join/… and /auth/confirm open the app:

	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.budgeer.com</string>
		<string>applinks:dev.budgeer.com</string>
	</array>
	-->
</dict>
</plist>
