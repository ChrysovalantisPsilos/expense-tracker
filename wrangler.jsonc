{
  // Static-assets Worker: serve the Vite build output (dist/) directly.
  // No server-side Worker code — this is a single-page app, so unknown
  // routes fall back to index.html for client-side (React Router) routing.
  //
  // Having this explicit config makes `wrangler deploy` skip framework
  // auto-detection (which otherwise demands Vite >= 6 via the Cloudflare
  // Vite plugin we don't use).
  "name": "expense-tracker",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
